# DealNote environment variables.
# Copy to .env.local and fill in real values. Never commit .env.local.
# No real values are stored in this file.

# Lemon Squeezy API key (server-only). Used for checkout creation and
# the webhook's licence-key lookup. Create it in the Lemon Squeezy
# dashboard (Settings -> API). Without it, checkout returns
# notConfigured and only the dev licence key below is accepted.
LEMONSQUEEZY_API_KEY=<redacted>

# Lemon Squeezy store id. Resonant Atlas store is 244487. Find it in
# Settings -> Stores in the Lemon Squeezy dashboard.
LEMONSQUEEZY_STORE_ID=244487

# Lemon Squeezy product id for the $49 one-time DealNote licence.
# Create the product in the Lemon Squeezy dashboard first (licence
# keys enabled), then paste its id here.
LEMONSQUEEZY_PRODUCT_ID=

# Lemon Squeezy variant id for the $49 one-time variant of the
# DealNote product. Find it on the product page in the dashboard.
LEMONSQUEEZY_VARIANT_ID=

# Lemon Squeezy webhook signing secret (server-only). You choose this
# value when you create the webhook in the Lemon Squeezy dashboard
# (Settings -> Webhooks); the webhook route verifies every event
# against it with HMAC-SHA256 (X-Signature header).
LEMONSQUEEZY_WEBHOOK_SECRET=<redacted>

# Optional hosted Lemon Squeezy checkout link, created in the
# dashboard. Used as a fallback only when LEMONSQUEEZY_API_KEY /
# LEMONSQUEEZY_VARIANT_ID are not set: /api/checkout returns this
# link instead of notConfigured.
LEMONSQUEEZY_CHECKOUT_URL=

# Local-test-only licence key. Accepted ONLY when Lemon Squeezy is not
# configured (no LEMONSQUEEZY_STORE_ID / LEMONSQUEEZY_VARIANT_ID).
# Never use a real customer licence key here, never ship this value,
# and never share it: anyone holding it gets full audits on a dev
# build. Leave blank in production; with Lemon Squeezy configured
# this value is ignored entirely.
DEALNOTE_DEV_LICENSE_KEY=

# Google PageSpeed Insights API key. Future use only: v1 scores speed from
# measured load time and page size, and does not call PageSpeed. Leave
# blank until the PageSpeed integration is built.
GOOGLE_PSI_API_KEY=<redacted>

# Upstash Redis (server-only). When set, the licence-quota store and the
# free rate limiter use Redis and survive Vercel cold starts; when unset,
# both fall back to in-memory stores (best-effort per instance). Create a
# free Upstash Redis database and paste its REST URL + token here and in
# Vercel env. No account or service is provisioned by the code itself.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=<redacted>
