# DealNote environment variables.
# Copy to .env.local and fill in real values. Never commit .env.local.
# No real values are stored in this file.

# Polar.sh API access token (server-only). Used for checkout, licence-key
# validation, and the webhook's licence-key lookup. Create it in the Polar
# dashboard (Settings -> API). Without it, checkout returns notConfigured
# and only the dev licence key below is accepted.
POLAR_ACCESS_TOKEN=

# Polar webhook signing secret (server-only). Set on the webhook endpoint
# in the Polar dashboard; the webhook route verifies every event against it.
POLAR_WEBHOOK_SECRET=

# Polar product id for the $49 one-time DealNote licence. Create the
# product in the Polar dashboard first, then paste its id here.
POLAR_PRODUCT_ID=

# Polar organization id. Required by the Polar licence-key validation API
# (licenseKeys.validate needs key + organization_id). Find it in the Polar
# dashboard organization settings.
POLAR_ORGANIZATION_ID=

# Polar environment: "production" (default) or "sandbox" for test mode.
# Only set to "sandbox" while testing with Polar test keys.
POLAR_SERVER=production

# Optional hosted Polar checkout link, created in the Polar dashboard.
# Used as a fallback only when POLAR_ACCESS_TOKEN / POLAR_PRODUCT_ID are
# not set: /api/checkout returns this link instead of notConfigured.
POLAR_CHECKOUT_URL=

# Local-test-only licence key. Accepted ONLY when Polar is not configured
# (no POLAR_ACCESS_TOKEN / POLAR_ORGANIZATION_ID). Never use a real
# customer licence key here, never ship this value, and never share it:
# anyone holding it gets full audits on a dev build. Leave blank in
# production; with Polar configured this value is ignored entirely.
DEALNOTE_DEV_LICENSE_KEY=

# Google PageSpeed Insights API key. Future use only: v1 scores speed from
# measured load time and page size, and does not call PageSpeed. Leave
# blank until the PageSpeed integration is built.
GOOGLE_PSI_API_KEY=

# Upstash Redis (server-only). When set, the licence-quota store and the
# free rate limiter use Redis and survive Vercel cold starts; when unset,
# both fall back to in-memory stores (best-effort per instance). Create a
# free Upstash Redis database and paste its REST URL + token here and in
# Vercel env. No account or service is provisioned by the code itself.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
